"use strict";
var thumbs = document.getElementById("thumbs");
var largeImg = document.getElementById("largeImg");
thumbs.addEventListener("click", function(e) {
    var link = null;
    if (e.target.tagName === "IMG") link = e.target.closest("a");
    else if (e.target.tagName === "A") link = e.target;
    if (link && link.hasAttribute("href")) e.preventDefault();
    if (link) {
        var newSrc = link.getAttribute("href");
        largeImg.src = newSrc;
    }
});

